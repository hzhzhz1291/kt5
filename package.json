{
  "name": "kt05-blog-chat",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "jest --runInBand",
    "admin:promote": "node src/scripts/promote.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "joi": "18.3.2",
    "jsonwebtoken": "9.0.3",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testTimeout": 12000
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  }
}
